## Fragment-Grammatik

```sql
match_recognize_clause ::=
  table_ref MATCH_RECOGNIZE (
    [ PARTITION BY expr { , expr } ]
    ORDER BY expr [ ASC | DESC ] { , expr [ ASC | DESC ] }
    [ MEASURES measure_expr AS alias { , measure_expr AS alias } ]
    [ ONE ROW PER MATCH | ALL ROWS PER MATCH ]
    [ AFTER MATCH SKIP PAST LAST ROW
    | AFTER MATCH SKIP TO NEXT ROW ]
    PATTERN ( pattern_string )
    [ WITHIN interval_expr ]
    [ DEFINE var AS boolean_expr { , var AS boolean_expr } ]
  ) [ AS alias ]
```

### Kurzgrammatik (EBNF-artig)

```
partition_clause
    ::= 'PARTITION BY' expr (',' expr)*

order_clause
    ::= 'ORDER BY' order_item (',' order_item)*

order_item
    ::= expr [ 'ASC' | 'DESC' ]

measures_clause
    ::= 'MEASURES' measure_item (',' measure_item)*

measure_item
    ::= measure_expr 'AS' identifier

measure_expr
    ::= var '.' column
      | aggregate_func '(' var '.' column ')'

aggregate_func
    ::= 'FIRST' | 'LAST' | 'COUNT' | 'MIN' | 'MAX' | 'SUM' | 'AVG'

rows_per_match_clause
    ::= 'ONE ROW PER MATCH'          
      | 'ALL ROWS PER MATCH'

after_match_skip_clause
    ::= 'AFTER MATCH SKIP PAST LAST ROW'    
      | 'AFTER MATCH SKIP TO NEXT ROW'

pattern_clause
    ::= 'PATTERN' '(' pattern_string ')'

within_clause
    ::= 'WITHIN' interval_expr

pattern_string
    ::= pattern_term ( ' ' pattern_term )*
      | pattern_term '|' pattern_term

pattern_term
    ::= pattern_atom [ quantifier ]

pattern_atom
    ::= identifier
      | '(' pattern_string ')'

quantifier
    ::= '*' | '+' | '?'

define_clause
    ::= 'DEFINE' define_item (',' define_item)*

define_item
    ::= identifier 'AS' boolean_expr
```

